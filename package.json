{
  "name": "@roost-cc/up-doc",
  "version": "1.0.0",
  "description": "Markdown documentation server with client-side rendering",
  "type": "module",
  "exports": {
    "./static/rewrite.cjs": "./static/rewrite.cjs"
  },
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "up-doc": "bin/up-doc.js"
  },
  "files": [
    "docserver.js",
    "bin/",
    "static/",
    "scripts/",
    "web/*.js",
    "web/*.css",
    "web/*.html"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roost-cc/up-doc.git"
  },
  "scripts": {
    "start": "node docserver.js",
    "test": "node --test 'test/unit/*.test.js' && playwright test -c test/playwright.config.js",
    "check": "node scripts/check.js",
    "check-links": "node scripts/check-links.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "mime-types": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "minisearch": "^7.2.0"
  }
}
